SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost
POSTGRES_DB=restromandu_demo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Base domain for tenant subdomains (used by tenant creation)
# Examples: localhost  OR  tenants.restromandu.com
TENANT_DOMAIN_BASE=restromandu.com
# Optional: explicit domain to map the public schema to
# If set, the management command will ensure this Domain exists for the public tenant
PUBLIC_TENANT_DOMAIN=tenants.restromandu.com



